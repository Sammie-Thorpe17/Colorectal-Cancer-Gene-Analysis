select_features <- function(df, gene_cols, n_top = N_TOP_GENES) {
  scores <- apply(df[, gene_cols, drop = FALSE], 2, sd, na.rm = TRUE)
  scores <- scores[!is.na(scores)]
  ranked <- names(sort(scores, decreasing = TRUE))          # high SD 
  ranked[seq_len(min(n_top, length(ranked)))]
}

