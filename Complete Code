# tells the model to treat each classes as equally weighted because early is larger
make_case_weights <- function(y) {
  freq <- table(y) # counts each stage
  w_per_class <- length(y) / (length(freq) * as.numeric(freq)) # the weight of each class 
  names(w_per_class) <- names(freq) # reattach each the class labels which were stripped by "as.numeric"
  unname(w_per_class[as.character(y)]) }

###################
## MCC ##
###################

mcc <- function(pred, truth, positive = "Late", negative = "Early") {
  pred  <- as.character(pred);  truth <- as.character(truth)
  TP <- sum(pred == positive & truth == positive)
  TN <- sum(pred == negative & truth == negative)
  FP <- sum(pred == positive & truth == negative)
  FN <- sum(pred == negative & truth == positive)
  denom <- sqrt((TP + FP) * (TP + FN) * (TN + FP) * (TN + FN))
  if (denom == 0) return(0)  # undefined (a row/col of the matrix is all zero)
  ((TP * TN) - (FP * FN)) / denom}

