# Named class-weight vector (svm wants weights per class label, not per row)
svm_class_weights <- function(y) {
  freq <- table(y)
  w <- length(y) / (length(freq) * as.numeric(freq))
  setNames(w, names(freq))}

# Building the SVM grid:
svm_grid <- do.call(rbind, lapply(SVM_KERNELS, function(k) { # runs every kernel for each hyperparameter
  if (k == "linear") { 
    expand.grid(kernel = k, cost = SVM_COST, gamma = NA_real_, # do not use gamma for linear 
                stringsAsFactors = FALSE) 
  } else {
    expand.grid(kernel = k, cost = SVM_COST, gamma = SVM_GAMMA,
                stringsAsFactors = FALSE)}}))
svm_grid$mean_mcc <- NA_real_ # creating empty results ready for the grid search
svm_grid$mean_f1  <- NA_real_
svm_grid$mean_auc <- NA_real_

# grid search
for (i in seq_len(nrow(svm_grid))) { 
  fold_mccs <- numeric(length(folds))
  fold_f1s  <- numeric(length(folds))
  fold_aucs <- numeric(length(folds))
  
  for (f in seq_along(folds)) {
    fc <- fold_cache[[f]]
    cw <- if (CLASS_WEIGHT == "balanced") svm_class_weights(fc$y_tr) else NULL
    
    # SVM model
    svm_grid_search <- list(
      x = fc$x_tr, y = fc$y_tr,
      kernel = svm_grid$kernel[i],
      cost   = svm_grid$cost[i],
      class.weights = cw,
      probability   = TRUE,
      scale         = FALSE )
    if (svm_grid$kernel[i] == "radial") svm_grid_search$gamma <- svm_grid$gamma[i]
    fit <- do.call(e1071::svm, svm_grid_search)
    # Class predictions
    pred <- predict(fit, fc$x_te, probability = TRUE)
    # Predicted probabilities
    prob <- attr(pred, "probabilities")[, "Late"]
    # MCC
    fold_mccs[f] <- mcc(
      pred,
      fc$y_te,
      positive = "Late",
      negative = "Early")
    # F1-score
    cm <- confusionMatrix(
      pred,
      fc$y_te,
      positive = "Late")
    fold_f1s[f] <- as.numeric(cm$byClass["F1"])
    # ROC-AUC
    roc_obj <- pROC::roc(
      response = fc$y_te,
      predictor = prob,
      levels = c("Early", "Late"),
      direction = "<",
      quiet = TRUE)
    fold_aucs[f] <- as.numeric(pROC::auc(roc_obj))}
  svm_grid$mean_mcc[i] <- mean(fold_mccs)
  svm_grid$mean_f1[i]  <- mean(fold_f1s)
  svm_grid$mean_auc[i] <- mean(fold_aucs)
  message(sprintf(
    "[SVM %2d/%d] kernel=%-6s cost=%-5g gamma=%-6s | MCC=%.3f | F1=%.3f | AUC=%.3f",
    i,
    nrow(svm_grid),
    svm_grid$kernel[i],
    svm_grid$cost[i],
    ifelse(is.na(svm_grid$gamma[i]), "-", svm_grid$gamma[i]),
    svm_grid$mean_mcc[i],
    svm_grid$mean_f1[i],
    svm_grid$mean_auc[i]))} 

# Sorted best-first. 
svm_grid_sorted <- svm_grid[order(-svm_grid$mean_mcc,  # 1. best CV MCC
                                  svm_grid$cost,        # 2. smaller cost
                                  svm_grid$gamma), ]    # 3. smaller gamma
print(svm_grid_sorted)

svm_best <- svm_grid_sorted[1, ]
message(sprintf("Best SVM: kernel=%s, cost=%g, gamma=%s (CV MCC=%.3f)",
                svm_best$kernel, svm_best$cost,
                ifelse(is.na(svm_best$gamma), "-", svm_best$gamma),
                svm_best$mean_mcc))

