# judged by identical rules 
evaluate_test <- function(prob, model_name, roc_col) {
  pred <- factor(ifelse(prob >= 0.5, "Late", "Early"), levels = c("Early", "Late")) # 0.5 threshold 
  confmatrix   <- confusionMatrix(pred, y_test, positive = "Late") # confusion matrix
  cat(sprintf("\n=== TEST SET: %s ===\n", model_name)) 
  print(confmatrix)
  m   <- mcc(pred, y_test, positive = "Late", negative = "Early") # mcc
  f1  <- as.numeric(confmatrix$byClass["F1"]) # f1 score
  roc <- pROC::roc(response = y_test, predictor = prob, # roc/auc value
                   levels = c("Early", "Late"), direction = "<")
  a   <- as.numeric(pROC::auc(roc))  # roc/auc value
  message(sprintf("%s Test MCC = %.3f | F1 = %.3f | AUC = %.3f", model_name, m, f1, a))
  plot(roc, col = roc_col, lwd = 2,
       main = sprintf("%s Test ROC (AUC = %.3f)", model_name, a))
  abline(a = 0, b = 1, lty = 2, col = "grey60")
  list(confmatrix = confmatrix, mcc = m, f1 = f1, auc = a, roc = roc)}

