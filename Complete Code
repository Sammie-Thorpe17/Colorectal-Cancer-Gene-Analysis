# setting which hyperparameters are used in the grid search
grid <- expand.grid(
  mtry          = GRID_MTRY,
  max_depth     = GRID_MAX_DEPTH,
  min_node_size = GRID_MIN_NODE_SIZE,
  KEEP.OUT.ATTRS = FALSE,
  stringsAsFactors = FALSE)
grid$mean_mcc <- NA_real_
grid$mean_f1  <- NA_real_
grid$mean_auc <- NA_real_

# setting the cross-validation
y_train_full <- as.factor(train_data_full$stage_binary)

set.seed(SEED)
folds <- createFolds(y_train_full, k = CV_FOLDS, list = TRUE)

# setting the folds for the cross validation
fold_cache <- lapply(seq_along(folds), function(f) {
  val_idx <- folds[[f]]
  tr <- train_data_full[-val_idx, , drop = FALSE]
  te <- train_data_full[ val_idx, , drop = FALSE]
  
  # feature selection on this fold's TRAINING portion only
  genes_f <- select_features(tr, gene_cols_all, n_top = N_TOP_GENES)
  
  list(
    x_tr = as.matrix(tr[, genes_f]),
    y_tr = as.factor(tr$stage_binary),
    x_te = as.matrix(te[, genes_f]),
    y_te = as.factor(te$stage_binary))})

# the outer loop
for (i in seq_len(nrow(grid))) { # uses every combination from the grid search
  fold_mccs <- numeric(length(folds)) 
  fold_f1s  <- numeric(length(folds))
  fold_aucs <- numeric(length(folds))
  
  # the inner loop
  for (f in seq_along(folds)) { # the cross-validation folds 
    fc <- fold_cache[[f]] 
    cw <- if (CLASS_WEIGHT == "balanced") make_case_weights(fc$y_tr) else NULL
    
    # random forest model
    fit <- ranger(
      x = fc$x_tr, y = fc$y_tr,
      num.trees     = NTREE,
      mtry          = grid$mtry[i],
      max.depth     = grid$max_depth[i],
      min.node.size = grid$min_node_size[i],
      case.weights  = cw,
      probability   = TRUE,
      seed          = SEED + f)
    prob <- predict(fit, data = fc$x_te)$predictions[, "Late"]
    pred <- factor(
      ifelse(prob >= 0.5, "Late", "Early"),
      levels = c("Early", "Late"))
    # MCC
    fold_mccs[f] <- mcc(
      pred,
      fc$y_te,
      positive = "Late",
      negative = "Early")
    # F1-score
    cm <- confusionMatrix(
      pred,
      fc$y_te,
      positive = "Late")
    fold_f1s[f] <- as.numeric(cm$byClass["F1"])
    # ROC-AUC
    roc_obj <- pROC::roc(
      response = fc$y_te,
      predictor = prob,
      levels = c("Early", "Late"),
      direction = "<",
      quiet = TRUE)
    fold_aucs[f] <- as.numeric(pROC::auc(roc_obj))}
  grid$mean_mcc[i] <- mean(fold_mccs)
  grid$mean_f1[i]  <- mean(fold_f1s)
  grid$mean_auc[i] <- mean(fold_aucs)
  message(sprintf(
    "[%2d/%d] mtry=%3d depth=%2d node=%2d | MCC=%.3f | F1=%.3f | AUC=%.3f",
    i, nrow(grid),
    grid$mtry[i],
    grid$max_depth[i],
    grid$min_node_size[i],
    grid$mean_mcc[i],
    grid$mean_f1[i],
    grid$mean_auc[i]))}

# final grid order 
grid_sorted <- grid[order(-grid$mean_mcc,      # 1. best CV MCC first
                          grid$max_depth,       # 2. prefer shallower trees
                          -grid$min_node_size,  # 3. then larger leaves
                          grid$mtry), ]         # 4. then fewer features/split
print(grid_sorted)

best <- grid_sorted[1, ]
message(sprintf("Best: mtry=%d, max.depth=%d, min.node.size=%d (CV MCC=%.3f)",
                best$mtry, best$max_depth, best$min_node_size, best$mean_mcc))

