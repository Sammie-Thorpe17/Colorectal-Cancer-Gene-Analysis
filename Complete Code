# Run the full Kernel SHAP 
run_shap_svm <- function(model, model_type, label) {
  
  predict_late <- function(object, newdata) {
    full <- matrix(rep(gene_baseline, each = nrow(newdata)),
                   nrow = nrow(newdata), ncol = length(high_sd_genes),
                   dimnames = list(NULL, high_sd_genes)) # all 2000 genes = training mean
    keep <- intersect(colnames(newdata), high_sd_genes) # the 20 explained genes
    full[, keep] <- as.matrix(newdata[, keep, drop = FALSE]) # the 20 explained genes
    full <- as.data.frame(full)
    
    p <- predict(object, full, probability = TRUE)
    attr(p, "probabilities")[, "Late"]}
  
  ks <- kernelshap::kernelshap(
    object   = model,
    X        = X_explain,
    bg_X     = bg_X,
    pred_fun = predict_late)
  sv <- shapviz::shapviz(ks)
  
  # mean SHAP per gene
  svm_bar <- shapviz::sv_importance(
    sv,
    kind = "bar",
    max_display = SHAP_N_GENES) +
    ggplot2::labs(
      x = "SHAPley value",
      y = "Gene")
  svm_bar$layers[[1]]$aes_params$fill <- "steelblue"
  print(svm_bar)
  
  # Beeswarm, positive is late and negative is early
  print(shapviz::sv_importance(sv, kind = "beeswarm", max_display = "SHAPley Value") +
          ggplot2::labs(title = sprintf("SHAPley (%s, test set)", label)))
  
  # Tabular mean SHAP ranking, traced back to Ensembl IDs
  shap_mat <- shapviz::get_shap_values(sv)
  imp <- data.frame(
    gene          = colnames(shap_mat),
    mean_abs_shap = colMeans(abs(shap_mat))) %>%
    mutate(ensembl = symbol_to_ensembl[gene]) %>%
    arrange(desc(mean_abs_shap))
  
  cat(sprintf("\n=== SHAPley importance: %s (test set) ===\n", label))
  print(imp)
  
  list(sv = sv, importance = imp)}

run_treeshap <- function(surrogate, train_X, explain_X, genes, label) {
  unified <- treeshap::ranger.unify(surrogate, train_X)
  ts      <- treeshap::treeshap(unified, explain_X, verbose = FALSE)
  sv_full <- shapviz::shapviz(ts, X = explain_X) # SHAP over all genes
  sv      <- sv_full[, genes] # subset to display genes
  
  # mean SHAP per gene
  rf_bar <- shapviz::sv_importance(
    sv,
    kind = "bar",
    max_display = SHAP_N_GENES) +
    ggplot2::labs(
      x = "SHAPley value",
      y = "Gene")
  rf_bar$layers[[1]]$aes_params$fill <- "steelblue"
  print(rf_bar)
  
  # Beeswarm, positive is late and negative is early
  print(shapviz::sv_importance(sv, kind = "beeswarm", max_display = "SHAPley Value") +
          ggplot2::labs(title = sprintf("SHAPley (%s, test set)", label)))
  
  shap_mat <- shapviz::get_shap_values(sv)
  imp <- data.frame(
    gene          = colnames(shap_mat),
    mean_abs_shap = colMeans(abs(shap_mat))) %>%
    mutate(ensembl = symbol_to_ensembl[gene]) %>%
    arrange(desc(mean_abs_shap))
  
  cat(sprintf("\n=== SHAPley importance: %s (treeshap, test set) ===\n", label))
  print(imp)
  
  list(sv = sv, importance = imp, sv_full = sv_full)}

